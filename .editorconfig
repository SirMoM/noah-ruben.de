[*]
insert_final_newline = true
charset = utf-8
max_line_length = off
trim_trailing_whitespace = true
indent_size = 4
indent_style = space

[{*.{yml,yaml},*.{json,md}}]
indent_size = 2

[*.{kt,kts}]
ktlint_code_style = intellij_idea
ktlint_standard_package-name = disabled
ij_kotlin_packages_to_use_import_on_demand = kotlinx.html